{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/application-local*.yaml)",
      "Read(./**/application-local*.yml)",
      "Read(./**/application-dev-local*.yaml)",
      "Read(./**/application-dev-local*.yml)"
    ]
  }
}
